{
  "mcpServers": {
    "hex_local": {
      "command": "/opt/homebrew/bin/mix",
      "args": ["mcp.server", "--no-compile"],
      "cwd": "your-path",
      "env": {
        "MIX_ENV": "prod",
        "MIX_QUIET": "1",
        "AI_API_KEY": "your-mistral-api-key",
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
        "MCP_LOG_FILE": "/absolute/path/to/local_hex_mcp/tmp_logs.txt",
        "MCP_LOG_LEVEL": "warning",
        "DATABASE_PATH": "your-path",
        "EMBED_BATCH_SIZE": "50",
        "EMBED_PAUSE_MS": "500",
        "PROJECT_ROOT": "/Users/nevendrean/code/local_hex_mcp"
      }
    }
  }
}
