MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=xxx

MISTRAL_MODEL_EMBED=mistral-embed
MISTRAL_MODEL_SMALL=mistral-small-latest
MISTRAL_LARGE_MODEL=mistral-medium-latest
GITHUB_API_URL=https://api.github.com

# GITHUB_TOKEN=xxx 

HEX_API_URL=https://hex.pm/api

# Local database (per project — two projects sharing one file overwrite each
# other's rows, since only one version per package is kept)
DATABASE_PATH=priv/mcp.db

# Ingestion tuning — all optional, see README. A bad value falls back to the default.
# INGEST_TIMEOUT_MS=25000
# EMBED_BATCH_SIZE=200
# EMBED_CONCURRENCY=2
# EMBED_PAUSE_MS=0
